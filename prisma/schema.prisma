// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id                   String        @id @default(cuid())
  name                 String        @default("Gupta Kirana & General Store")
  ownerName            String        @default("Ramesh Gupta")
  phone                String?
  isDemo               Boolean       @default(false)
  baseCreditLimitPaise Int           @default(500000) // Default ₹5,000 base credit limit
  reorderDaysOfCover   Int           @default(14)     // Target days of stock cover (default 14 days)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  customers            Customer[]
  entries              LedgerEntry[]
  items                Item[]
  sales                Sale[]
}

model Customer {
  id        String        @id @default(cuid())
  shopId    String
  name      String
  phone     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@index([shopId])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  shopId      String
  customerId  String
  type        String   // "CREDIT_GIVEN" | "PAYMENT_RECEIVED"
  amountPaise Int      // stored in paise (1 INR = 100 paise)
  note        String?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([customerId])
}

model Item {
  id         String   @id @default(cuid())
  shopId     String
  name       String
  costPaise  Int      // Cost price in paise
  pricePaise Int      // Selling price in paise
  quantity   Int      // Current stock quantity (never negative)
  category   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@index([shopId])
}

model Sale {
  id             String   @id @default(cuid())
  shopId         String
  itemId         String
  quantity       Int      // Quantity sold (positive integer)
  unitPricePaise Int      // Selling price per unit in paise
  totalPaise     Int      // quantity * unitPricePaise
  createdAt      DateTime @default(now())
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([itemId])
}
