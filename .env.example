# SQLite database connection URL with connection limit of 1 to ensure serialized write locks
DATABASE_URL="file:./dev.db?connection_limit=1"

# Single master password for shopkeeper access (set your own secret password)
SHOP_PASSWORD="your_secure_password_here"

# HMAC Session secret (minimum 32 characters long random string)
SESSION_SECRET="your_random_hmac_secret_key_minimum_32_characters_long"

# Optional: Google Gemini API key for Profit Saathi natural language morning briefings
GEMINI_API_KEY="your_optional_gemini_api_key_here"
